,\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L6\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"$L7\",null,{}]]}],[\"$\",\"$L8\",null,{}],[\"$\",\"$L9\",null,{}],[\"$\",\"$La\",null,{}],[\"$\",\"$Lb\",null,{}],[\"$\",\"$Lc\",null,{}]]}]]}]}]]}],{\"children\":[\"privacy\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-6 py-24\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-[28px] font-bold text-text-primary tracking-tight\",\"children\":\"Privacy Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-[13px] text-text-muted\",\"children\":[\"Last updated: \",\"07/04/2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-6 text-text-secondary text-[13px] leading-relaxed\",\"children\":[[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"1. Overview\"}],[\"$\",\"p\",null,{\"children\":\"NexVid is designed to work primarily with data stored locally in your browser. If backend login/cloud sync is enabled for this deployment, selected account data is also processed by the configured backend API.\"}]]}],[\"$\",\"section\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-[13px] text-text-muted\",\"children\":[\"© \",2026,\" NexVid · All rights reserved.\"]}]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"2. Data We Process\"}],[\"$\",\"p\",null,{\"children\":[\"By default, data is stored in your browser's \",[\"$\",\"code\",null,{\"className\":\"text-accent\",\"children\":\"localStorage\"}],\". If cloud auth is enabled, the backend stores only data necessary to run account, security, and moderation features.\"]}],[\"$\",\"ul\",null,{\"className\":\"mt-2 list-disc list-inside space-y-1 text-text-muted\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Account data: nickname, password hash, account creation date\"}],[\"$\",\"li\",null,{\"children\":\"Session data: authentication tokens and token expiry data\"}],[\"$\",\"li\",null,{\"children\":\"App data: settings, watchlist, playback-related preferences\"}],[\"$\",\"li\",null,{\"children\":\"Security data: hashed anti-abuse identifiers (e.g. hashed IP/fingerprint signals)\"}],[\"$\",\"li\",null,{\"children\":\"Moderation/admin data: bans, audit logs, security events, timestamps\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"We do not require email verification to use accounts in the current deployment.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"3. Purposes and Legal Basis (GDPR)\"}],\"$Ld\",\"$Le\",\"$Lf\",\"$L10\"]}],\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}]]}],null,\"$L18\"]}],{},null,false]},null,false]},[\"$L19\",[],[]],false],\"$L1a\",false]],\"m\":\"$undefined\",\"G\":[\"$1b\",[]],\"s\":false,\"S\":true}\n1c:I[4431,[],\"OutletBoundary\"]\n1e:I[5278,[],\"AsyncMetadataOutlet\"]\n20:I[4456,[\"5069\",\"static/chunks/5069-27c742022120c48c.js\",\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"2473\",\"static/chunks/2473-776dd8e73f0f7795.js\",\"1670\",\"static/chunks/1670-2c8eeb8ceb2a7de1.js\",\"4456\",\"static/chunks/4456-78b007a289a2c4a2.js\",\"8974\",\"static/chunks/app/page-f651d0fc8a644d21.js\"],\"MediaRowSkeleton\"]\n21:I[4431,[],\"ViewportBoundary\"]\n23:I[4431,[],\"MetadataBoundary\"]\n24:\"$Sreact.suspense\"\nd:[\"$\",\"p\",null,{\"children\":\"We process data for: (a) account login/session handling, (b) app functionality and optional sync, and (c) security and abuse prevention.\"}]\ne:[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"The legal basis is generally:\"}]\nf:[\"$\",\"ul\",null,{\"className\":\"mt-2 list-disc list-inside space-y-1 text-text-muted\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Article 6(1)(b) GDPR\"}],\" (performance of a contract) for account/service operation\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Article 6(1)(f) GDPR\"}],\" (legitimate interest) for security, anti-abuse and moderation\"]}]]}]\n10:[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"Where local browser storage is strictly necessary for requested functionality, it is used on that basis.\"}]\n11:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"4. Third-Party Services\"}],[\"$\",\"p\",null,{\"children\":\"NexVid may connect to external services needed to render content and metadata:\"}],[\"$\",\"ul\",null,{\"className\":\"mt-2 list-disc list-inside space-y-1 text-text-muted\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"TMDB API\"}],\" — movie/show metadata, posters, and search data\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"OMDb API\"}],\" — external ratings and additional title metadata\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"FebBox\"}],\" — streaming source/provider integration used by resolver flows\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"TheIntroDB\"}],\" — optional intro/outro segment metadata\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Wyzie Subs\"}],\" — Multi-language subtitles and translations.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Groq\"}],\" — inference platform used by the AI Assistant.\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"These services operate under their own privacy policies and terms. We recommend reviewing the policies for TMDB, OMDb, FebBox, TheIntroDB, and Groq directly if you use features that rely on them.\"}]]}]\n12:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"5. Cookies and Local Storage\"}],[\"$\",\"p\",null,{\"children\":[\"NexVid uses only technically necessary client-side storage (primarily \",[\"$\",\"code\",null,{\"className\":\"text-accent\",\"children\":\"localStorage\"}],\") and authentication/session mechanisms required to operate the service. We do not use advertising or tracking cookies.\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"If non-essential analytics or marketing cookies are introduced in a future release, this policy and consent flow will be updated accordingly.\"}]]}]\n13:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"6. Retention\"}],[\"$\",\"p\",null,{\"children\":\"We keep data only as long as needed for account operation, service reliability, and abuse prevention. Retention may vary by data type (e.g., session records vs. moderation logs) and may be adjusted where required by law or security obligations.\"}]]}]\n14:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"7. Analytics\"}],[\"$\",\"p\",null,{\"children\":\"This deployment does not use behavioral advertising trackers. If operational telemetry is enabled by the infrastructure provider, it is used for reliability/security, not ad profiling.\"}]]}]\n15:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"8. Your Rights (EU/EEA)\"}],[\"$\",\"p\",null,{\"children\":\"Subject to applicable law, you may request access, rectification, erasure, restriction, objection, and data portability where relevant. You may also object to processing based on legitimate interest.\"}]]}]\n16:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"9. Your Control\"}],[\"$\",\"p\",null,{\"children\":\"You can delete all stored data at any time by clearing your browser's localStorage, or by using the “Clear Everything” option in the Settings page.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"For this deployment, data stored on our backend (Cloudflare D1) is deleted only when you use “Clear Everything” while logged into your account.\"}]]}]\n17:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[15px] font-semibold text-text-primary mb-2\",\"children\":\"10. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mb-2\",\"children\":\"For privacy requests related to this deployment (including account deletion, access requests, or security concerns), please contact our security team:\"}],[\"$\",\"a\",null,{\"href\":\"mailto:security@nexvid.online\",\"className\":\"text-accent hover:underline font-medium\",\"children\":\"security@nexvid.online\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 mb-2\",\"children\":\"For general support and other inquiries:\"}],[\"$\",\"a\",null,{\"href\":\"mailto:support@nexvid.online\",\"className\":\"text-accent hover:underline font-medium\",\"children\":\"support@nexvid.online\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 mb-2\",\"children\":\"Community and quick updates:\"}],[\"$\",\"a\",null,{\"href\":\"https://cloud.umami.is/q/vCu19Bcub\",\"target\":\"